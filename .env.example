# Variáveis de ambiente do iWorld Prime.
# Cadastre na Vercel: Project Settings > Environment Variables (Production).
# NUNCA commite os valores reais.

# Supabase: chave SECRETA (sb_secret_... / service_role). Só no servidor.
SUPABASE_SERVICE_KEY=

# Mercado Pago: Access Token de PRODUÇÃO (APP_USR-...).
MP_ACCESS_TOKEN=

# Segredo para assinar o token de sessão do painel admin (texto aleatório longo).
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_SESSAO_SECRET=

# Administrador principal. SAL e HASH saem de: node scripts/gerar-admin.js
ADMIN_EMAIL=
ADMIN_SAL=
ADMIN_HASH=

# Administradores extras (opcional): _2 até _8
# ADMIN_EMAIL_2=
# ADMIN_SAL_2=
# ADMIN_HASH_2=
